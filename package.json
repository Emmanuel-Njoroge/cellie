{
  "name": "cellie",
  "version": "2.0.0",
  "private": true,
  "description": "Cellie: a classroom biomedical learning app with a Postgres database for student progress, minutes tracked, and teacher management.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dev": "npm run build && netlify dev",
    "dev:local": "npm run build && node scripts/dev-server.mjs",
    "db:migrate": "netlify database migrations apply"
  },
  "dependencies": {
    "@netlify/database": "^2.0.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15"
  },
  "engines": { "node": ">=20" }
}
